{
  "name": "obsidian-excerpts",
  "private": true,
  "version": "0.2.0-beta.10",
  "description": "Native Markdown excerpt cards for Obsidian",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node esbuild.config.mjs",
    "build:offline": "node scripts/build-offline.cjs",
    "typecheck:offline": "tsc -p tsconfig.offline.json --noEmit",
    "test": "node scripts/test.cjs",
    "smoke": "node scripts/smoke.cjs",
    "verify": "npm run test && npm run build && npm run smoke && npm run ui && node scripts/check-release.cjs",
    "ui": "node --test tests/ui.test.cjs tests/styles.test.cjs tests/visual-harness.test.cjs"
  },
  "devDependencies": {
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "esbuild": "^0.25.5",
    "jsdom": "^26.1.0"
  }
}
